      {
        "name": "Detector alarms",
        "datasource": {
          "type": "grafana-postgresql-datasource",
          "uid": "drift-history"
        },
        "enable": true,
        "iconColor": "red",
        "target": {
          "refId": "Alarms",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "drift-history"
          },
          "editorMode": "code",
          "rawQuery": true,
          "rawSql": "SELECT ts AS time, 'alarm of ' || method AS text, 'alarm' AS tags FROM alarms WHERE session_id = $session AND $__timeFilter(ts)",
          "format": "table"
        }
      },
      {
        "name": "Model changed",
        "datasource": {
          "type": "grafana-postgresql-datasource",
          "uid": "drift-history"
        },
        "enable": true,
        "iconColor": "green",
        "target": {
          "refId": "Applied",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "drift-history"
          },
          "editorMode": "code",
          "rawQuery": true,
          "rawSql": "SELECT ts AS time, summary AS text, 'model changed' AS tags FROM reviews WHERE session_id = $session AND outcome = 'applied' AND $__timeFilter(ts)",
          "format": "table"
