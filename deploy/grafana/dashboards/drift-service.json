{
  "uid": "drift-service",
  "title": "Drift service",
  "tags": [
    "drift",
    "stream B"
  ],
  "timezone": "browser",
  "editable": true,
  "schemaVersion": 39,
  "version": 1,
  "refresh": "5s",
  "time": {
    "from": "now-15m",
    "to": "now"
  },
  "templating": {
    "list": []
  },
  "annotations": {
    "list": []
  },
  "panels": [
    {
      "id": 1,
      "type": "timeseries",
      "title": "Requests per second by endpoint",
      "description": "",
      "datasource": {
        "type": "prometheus",
        "uid": "drift-prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 12,
        "h": 7
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "drift-prometheus"
          },
          "editorMode": "code",
          "expr": "sum by (path) (rate(drift_api_requests_total[1m]))",
          "legendFormat": "{{path}}",
          "range": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {
            "lineWidth": 1,
            "fillOpacity": 0,
            "showPoints": "never",
            "spanNulls": false
          },
          "color": {
            "mode": "palette-classic"
          },
          "unit": "reqps"
        },
        "overrides": []
      },
      "options": {}
    },
    {
      "id": 2,
      "type": "timeseries",
      "title": "Request latency, 95th percentile",
      "description": "",
      "datasource": {
        "type": "prometheus",
        "uid": "drift-prometheus"
      },
      "gridPos": {
        "x": 12,
        "y": 0,
        "w": 12,
        "h": 7
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "drift-prometheus"
          },
          "editorMode": "code",
          "expr": "histogram_quantile(0.95, sum by (le, path) (rate(drift_api_request_seconds_bucket[5m])))",
          "legendFormat": "{{path}}",
          "range": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {
            "lineWidth": 1,
            "fillOpacity": 0,
            "showPoints": "never",
            "spanNulls": false
          },
          "color": {
            "mode": "palette-classic"
          },
          "unit": "s"
        },
        "overrides": []
      },
      "options": {}
    },
    {
      "id": 3,
      "type": "stat",
      "title": "Sessions",
      "description": "",
      "datasource": {
        "type": "prometheus",
        "uid": "drift-prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 7,
        "w": 6,
        "h": 5
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "drift-prometheus"
          },
          "editorMode": "code",
          "expr": "drift_sessions",
          "legendFormat": "{{state}}",
          "range": true
        }
      ],
      "fieldConfig": {
        "defaults": {},
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "textMode": "value_and_name",
        "colorMode": "value"
      }
    },
    {
      "id": 4,
      "type": "timeseries",
      "title": "Hours of data read per second, by session",
      "description": "",
      "datasource": {
        "type": "prometheus",
        "uid": "drift-prometheus"
      },
      "gridPos": {
        "x": 6,
        "y": 7,
        "w": 18,
        "h": 5
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "drift-prometheus"
          },
          "editorMode": "code",
          "expr": "sum by (session, series) (rate(drift_hours_read_total[30s]))",
          "legendFormat": "{{session}}: {{series}}",
          "range": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {
            "lineWidth": 1,
            "fillOpacity": 0,
            "showPoints": "never",
            "spanNulls": false
          },
          "color": {
            "mode": "palette-classic"
          },
          "decimals": 1
        },
        "overrides": []
      },
      "options": {}
    },
    {
      "id": 5,
      "type": "timeseries",
      "title": "Reviews per 5 minutes by outcome",
      "description": "",
      "datasource": {
        "type": "prometheus",
        "uid": "drift-prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 12,
        "w": 12,
        "h": 7
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "drift-prometheus"
          },
          "editorMode": "code",
          "expr": "sum by (outcome) (increase(drift_review_outcomes_total[5m]))",
          "legendFormat": "{{outcome}}",
          "range": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {
            "lineWidth": 1,
            "fillOpacity": 0,
            "showPoints": "never",
            "spanNulls": false
          },
          "color": {
            "mode": "palette-classic"
          },
          "decimals": 0
        },
        "overrides": []
      },
      "options": {}
    },
    {
      "id": 6,
      "type": "timeseries",
      "title": "Time of a review, 95th percentile, by strategy",
      "description": "",
      "datasource": {
        "type": "prometheus",
        "uid": "drift-prometheus"
      },
      "gridPos": {
        "x": 12,
        "y": 12,
        "w": 12,
        "h": 7
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "drift-prometheus"
          },
          "editorMode": "code",
          "expr": "histogram_quantile(0.95, sum by (le, strategy) (rate(drift_review_seconds_bucket[5m])))",
          "legendFormat": "{{strategy}}",
          "range": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {
            "lineWidth": 1,
            "fillOpacity": 0,
            "showPoints": "never",
            "spanNulls": false
          },
          "color": {
            "mode": "palette-classic"
          },
          "unit": "s"
        },
        "overrides": []
      },
      "options": {}
    },
    {
      "id": 7,
      "type": "timeseries",
      "title": "MASE over the last 7 days read, by session",
      "description": "",
      "datasource": {
        "type": "prometheus",
        "uid": "drift-prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 19,
        "w": 12,
        "h": 7
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "drift-prometheus"
          },
          "editorMode": "code",
          "expr": "drift_mase_7d",
          "legendFormat": "{{session}} {{model}}",
          "range": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {
            "lineWidth": 1,
            "fillOpacity": 0,
            "showPoints": "never",
            "spanNulls": false
          },
          "color": {
            "mode": "palette-classic"
          },
          "decimals": 3
        },
        "overrides": []
      },
      "options": {}
    },
    {
      "id": 8,
      "type": "timeseries",
      "title": "Model fits per minute: apply and check",
      "description": "",
      "datasource": {
        "type": "prometheus",
        "uid": "drift-prometheus"
      },
      "gridPos": {
        "x": 12,
        "y": 19,
        "w": 12,
        "h": 7
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "drift-prometheus"
          },
          "editorMode": "code",
          "expr": "sum by (purpose) (rate(drift_model_fits_total[1m])) * 60",
          "legendFormat": "{{purpose}}",
          "range": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {
            "lineWidth": 1,
            "fillOpacity": 0,
            "showPoints": "never",
            "spanNulls": false
          },
          "color": {
            "mode": "palette-classic"
          },
          "decimals": 1
        },
        "overrides": []
      },
      "options": {}
    },
    {
      "id": 9,
      "type": "timeseries",
      "title": "Service CPU (cores) and memory",
      "description": "",
      "datasource": {
        "type": "prometheus",
        "uid": "drift-prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 26,
        "w": 24,
        "h": 6
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "drift-prometheus"
          },
          "editorMode": "code",
          "expr": "rate(process_cpu_seconds_total{job=\"drift-api\"}[1m])",
          "legendFormat": "CPU, cores",
          "range": true
        },
        {
          "refId": "B",
          "datasource": {
            "type": "prometheus",
            "uid": "drift-prometheus"
          },
          "editorMode": "code",
          "expr": "process_resident_memory_bytes{job=\"drift-api\"} / 2^30",
          "legendFormat": "memory, GiB",
          "range": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {
            "lineWidth": 1,
            "fillOpacity": 0,
            "showPoints": "never",
            "spanNulls": false
          },
          "color": {
            "mode": "palette-classic"
          },
          "decimals": 2
        },
        "overrides": []
      },
      "options": {}
    }
  ]
}
